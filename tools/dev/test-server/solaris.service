[Unit]
Description=Krasnokamen Minecraft server (test)
After=network-online.target
Wants=network-online.target

[Service]
User=krasnokamen
Group=krasnokamen
Environment=KRASNOKAMEN_SERVER_DIR=/opt/solaris
EnvironmentFile=-/etc/default/solaris
ExecStart=/bin/sh -c 'cd "$$KRASNOKAMEN_SERVER_DIR" && export HOME="$$KRASNOKAMEN_SERVER_DIR" && exec ./krasnokamen --config "$$KRASNOKAMEN_SERVER_DIR/server.toml" --no-console'
Restart=on-failure
RestartSec=5
MemoryMax=3G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
