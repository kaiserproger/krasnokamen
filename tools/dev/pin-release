#!/usr/bin/env python3
"""Build or reuse one immutable release pin, identified by source, binary kind and Rust target.

Owner-host tool (see tools/dev/README.md). The pin is identified by the tree's
HEAD and a hash of its uncommitted changes; the same tree is built once and every
later call prints the pinned binary. stdout carries only the final
KRASNOKAMEN_SERVER_BINARY=<path> (or KRASNOKAMEN_CLIENT_BINARY / KRASNOKAMEN_BOTS_BINARY).
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wtlib as w  # noqa: E402

KINDS = {
    "server": {"repo": "core", "package": "mc-edge", "bin": "krasnokamen", "env": "KRASNOKAMEN_SERVER_BINARY"},
    "client": {"repo": "client", "package": "krasnokamen-client", "bin": "krasnokamen-client", "env": "KRASNOKAMEN_CLIENT_BINARY"},
    "bots": {"repo": "core", "package": "mc-test-harness", "bin": "player-scale-bots", "env": "KRASNOKAMEN_BOTS_BINARY"},
    # The release mc-core lib test executable (`cargo test --release --no-run`), for a frozen
    # workload such as core::checkpoint_cost_bench::checkpoint_cost_ladder under `mem-run -x`:
    # cargo names it `mc_core-<hash>`, so the artifact comes from cargo's JSON report.
    # 12G, not 6G: the release mc-core lib test build was killed (exit 143) under the 6G
    # cap in a CAF-04 BASE pin (2026-11-15).
    "core-tests": {"repo": "core", "package": "mc-core", "bin": "", "env": "KRASNOKAMEN_CORE_TESTS_BINARY", "test": True,
                   "mem": "12G"},
}
# Everything a server or bots release build reads: Cargo workspace files, every crate, the guest SDK
# and the Java sources mc-edge embeds with include_str! (crates/mc-edge/src/content_import.rs, the
# only include outside crates/ and sdk/; audited 2026-11-11 over every build.rs, include_str!,
# include_bytes!, include! and env!("CARGO_MANIFEST_DIR") in crates/ and sdk/). A pin whose inputs
# match an existing pin's is that pin's binary: see reuse_pin.
INPUT_PATHS = (
    "crates", "sdk", "Cargo.toml", "Cargo.lock", ".cargo", "rust-toolchain.toml",
    "tools/extract-block-map-colors", "tools/extract-block-light", "tools/extract-block-mining",
    "tools/extract-block-explosion", "tools/VanillaWorldgenOracle.java",
)
# What a client release build reads: its own workspace (patched winit is a path dependency).
CLIENT_INPUT_PATHS = (
    "src", "launcher", "paths", "vendor", "build.rs", "Cargo.toml", "Cargo.lock", ".cargo",
    "rust-toolchain.toml",
)
# Environment that changes what cargo/rustc produce (build() pops the target variables itself).
BUILD_ENV = re.compile(
    r"^(RUSTFLAGS|RUSTDOCFLAGS|CARGO_ENCODED_RUSTFLAGS|RUSTC.*|CARGO_PROFILE_.*|CARGO_BUILD_.*|"
    r"CARGO_TARGET_.*|CARGO_CFG_.*|CC|CXX|CFLAGS|CXXFLAGS|LDFLAGS)$")
BUILD_ENV_IGNORED = {"CARGO_BUILD_JOBS", "CARGO_BUILD_TARGET", "CARGO_TARGET_DIR", "CARGO_INCREMENTAL"}
# What cargo itself tracks as environment inputs of a finished build (see build_env_names).
RERUN_ENV = re.compile(r"^cargo::?rerun-if-env-changed=(\S+)\s*$")
DEP_INFO_ENV = re.compile(r"^# env-dep:([^=\s]+)")
# mem-run's pool lock files: slot-<l> is held through /tmp/solaris-mem-slots/<l>.
SLOT_LOCKS = Path("/tmp/solaris-mem-slots")


def say(message: str) -> None:
    print(f"pin-release: {message}", file=sys.stderr)


def check_tree(top: Path, kind: str) -> None:
    if kind in ("server", "bots") and not (top / "crates/mc-edge/Cargo.toml").is_file():
        raise w.ToolError(f"{top} is not a core Krasnokamen tree (no crates/mc-edge); use --client for the client")
    if kind == "core-tests" and not (top / "crates/mc-core/Cargo.toml").is_file():
        raise w.ToolError(f"{top} is not a core Krasnokamen tree (no crates/mc-core)")
    if kind == "client":
        manifest = top / "Cargo.toml"
        if not manifest.is_file() or 'name = "krasnokamen-client"' not in manifest.read_text():
            raise w.ToolError(f"{top} is not a krasnokamen-client tree; omit --client for the server")


def provenance(top: Path) -> dict:
    """HEAD plus a hash of the uncommitted changes (`git diff HEAD --binary`, untracked files included)."""
    head = str(w.git(top, "rev-parse", "HEAD"))
    tree, untracked = w.working_state(top)
    diff = w.git(top, "diff", "--binary", "--no-ext-diff", "--no-textconv", "--no-color", "HEAD", tree, binary=True)
    diff_sha = w.sha256_bytes(diff)
    return {
        "head": head, "tree": tree, "diff_sha256": diff_sha, "dirty": bool(diff), "untracked_files": len(untracked),
        "id": head[:12] + (f"-{diff_sha[:8]}" if diff else ""),
    }


def cargo_config_files(top: Path) -> list[Path]:
    """Existing Cargo config files outside the tree that Cargo merges into this build, in Cargo's
    precedence order: `.cargo/config[.toml]` in each parent directory (nearest first), then CARGO_HOME.
    The tree's own `.cargo/` is in INPUT_PATHS. Only existing files count, by path and content (Cargo
    resolves `relative = true` values from the config's location), so identical trees at different depths
    (main and wt/<name>) share a key while a config appearing above either changes it."""
    home = Path(os.environ.get("CARGO_HOME") or Path.home() / ".cargo")
    found: list[Path] = []
    for directory in [parent / ".cargo" for parent in top.resolve().parents] + [home]:
        for name in ("config.toml", "config"):
            path = (directory / name).resolve()
            if path.is_file() and path not in found:
                found.append(path)
    return found


def inputs_sha256(top: Path, tree: str, kind: str, rust_target: str, incremental: bool,
                  paths: tuple[str, ...] = INPUT_PATHS) -> str:
    """Digest of everything the build reads, from the tree object of the working state.

    `tree` is wtlib.working_state's tree (HEAD plus uncommitted and untracked non-ignored files), so a
    tracked, dirty or untracked change inside INPUT_PATHS changes the key and one outside does not.
    Ignored files are not part of it (nothing in the audited includes reads one)."""
    parts = [f"{path}={w.git(top, 'rev-parse', '--verify', '--quiet', f'{tree}:{path}', check=False) or 'absent'}"
             for path in paths]
    parts.append("rustc=" + str(subprocess.check_output(["rustc", "-vV"], cwd=top, text=True)).strip())
    parts += [f"env.{name}={value}" for name, value in sorted(os.environ.items())
              if BUILD_ENV.match(name) and name not in BUILD_ENV_IGNORED]
    parts += [f"cargo_config.{path}={w.sha256_file(path)}" for path in cargo_config_files(top)]
    parts += [f"target={rust_target}", f"kind={kind}", f"incremental={int(incremental)}"]
    return w.sha256_bytes("\n".join(parts).encode())


def kind_inputs(top: Path, before: dict, kind: str, rust_target: str, incremental: bool) -> str | None:
    """The build-input digest of this tree for `kind` (None for a kind with no input list)."""
    paths = CLIENT_INPUT_PATHS if kind == "client" else INPUT_PATHS
    return inputs_sha256(top, before["tree"], kind, rust_target, incremental, paths)


def build_env(incremental: bool) -> dict[str, str]:
    """The environment build() runs cargo with: ours, minus the target variables, plus the explicit
    CARGO_INCREMENTAL. It is also what a reuse decision compares against (see build_env_deps)."""
    env = dict(os.environ)
    env.pop("CARGO_TARGET_DIR", None)
    env.pop("CARGO_BUILD_TARGET", None)
    env["CARGO_INCREMENTAL"] = str(int(incremental))
    return env


def build_env_names(artifact: Path, slot: Path) -> set[str]:
    """Environment variable names cargo tracks for the build that produced `artifact`, from cargo's own
    records: every `cargo:rerun-if-env-changed=VAR` (also `cargo::`) in build/*/output of build scripts, and
    every `# env-dep:VAR[=value]` line in the dep-info (deps/*.d and the binary's .d). Read from the
    artifact's profile directory and the slot's host `release/` (build scripts and proc macros of a
    --target build live there). A pooled slot also holds stale outputs of other builds; including their
    names is harmless, it only reduces reuse."""
    directories = {artifact.parent, slot / "release"}
    names: set[str] = set()
    for directory in directories:
        files = [*directory.glob("build/*/output"), *directory.glob("deps/*.d"), artifact.parent / (artifact.stem + ".d")]
        for path in files:
            try:
                lines = path.read_text(errors="replace").splitlines()
            except OSError:
                continue
            for line in lines:
                match = RERUN_ENV.match(line) or DEP_INFO_ENV.match(line)
                if match:
                    names.add(match.group(1))
    return names


def build_env_deps(names: set[str], env: dict[str, str]) -> dict[str, str | None]:
    """Sorted NAME -> value (None when unset) in `env` for every tracked name."""
    return {name: env.get(name) for name in sorted(names)}


def env_deps_match(recorded: object, env: dict[str, str]) -> bool:
    """True only when a manifest recorded the map and `env` holds the same value (or absence) for every name."""
    return isinstance(recorded, dict) and all(env.get(name) == value for name, value in recorded.items())


def reuse_pin(pin_dir: Path, top: Path, kind: str, rust_target: str, incremental: bool, inputs: str,
              before: dict) -> Path | None:
    """Create `pin_dir` from an existing pin with the same build inputs, without building, or return None.

    Candidates are valid pins only (the same HEAD and uncommitted state, the same repo/kind/target/
    incremental/inputs, and a binary present with its recorded sha256); a damaged one is skipped, never
    repaired, and another tree's pin is never relabelled as this tree's. The binary is hard-linked
    (copied if linking fails) and the manifest records this tree's provenance, the shared inputs and
    `reused_from`. A bots or core-tests pin is reused only by the tree that built it (see below). A candidate is also valid only if it recorded
    `env_deps` (the environment variables cargo tracked for its build, see build_env_names) and this process's
    build environment holds the same value or absence for each; a manifest without the map is never reused."""
    spec = KINDS[kind]
    env = build_env(incremental)
    for candidate in sorted(w.PINS.glob("*/manifest.json")):
        try:
            info = json.loads(candidate.read_text())
        except (OSError, ValueError):
            continue
        source_dir = candidate.parent
        # The same tree means the same working state, not only the same build inputs: a pin of
        # another HEAD or of other uncommitted changes is another tree (owner, 2026-11-15). Its
        # provenance is never stamped onto this tree.
        if (info.get("head") != before["head"] or info.get("diff_sha256") != before["diff_sha256"]
                or info.get("inputs_sha256") != inputs or info.get("repo") != spec["repo"] or info.get("kind") != kind
                or info.get("target") != rust_target or bool(info.get("incremental", False)) != incremental):
            continue
        if not env_deps_match(info.get("env_deps"), env):
            continue
        binary = Path(info.get("binary", ""))
        if binary.parent != source_dir or not binary.is_file() or w.sha256_file(binary) != info.get("binary_sha256"):
            continue
        if kind in ("bots", "core-tests") and info.get("build_tree") != str(top):
            # player-scale-bots reads <build tree>/data/vanilla/reports at every run and mc-core's
            # tests bake their CARGO_MANIFEST_DIR (world, data) paths the same way: a copy built in
            # another tree stops working when that tree is removed. Reuse only your own.
            continue
        stage = w.PINS / f".tmp-{pin_dir.name}-{os.getpid()}"
        try:
            stage.mkdir()
            staged = stage / binary.name
            try:
                os.link(binary, staged)
            except OSError:
                shutil.copyfile(binary, staged)
                staged.chmod(0o555)
            manifest = {
                "repo": spec["repo"], "head": before["head"], "diff_sha256": before["diff_sha256"],
                "kind": kind, "target": rust_target, "incremental": incremental,
                "dirty": before["dirty"], "untracked_files": before["untracked_files"], "source": str(top),
                "binary": str(pin_dir / binary.name), "binary_sha256": info["binary_sha256"],
                "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "command": info.get("command", ""),
                "inputs_sha256": inputs, "build_tree": info.get("build_tree"), "env_deps": info["env_deps"], "reused_from": source_dir.name,
            }
            (stage / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
            (stage / "manifest.json").chmod(0o444)
            os.rename(stage, pin_dir)
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        return pin_dir / binary.name
    return None


def existing_pin(pin_dir: Path, kind: str, rust_target: str, incremental: bool,
                 inputs: str | None = None, before: dict | None = None) -> Path | None:
    """The binary of a valid existing pin, or None; a damaged or foreign pin is an error.

    `before` is this run's provenance: with it the pin must describe the same working state
    (HEAD and uncommitted-state hash), because a pin of another tree is never this tree's binary
    (owner 2026-11-15) — an old pin written by the pre-fix cross-tree reuse is refused, not
    relabelled. Pins are immutable, so the owner removes such a pin deliberately."""
    manifest = pin_dir / "manifest.json"
    if not manifest.is_file():
        return None
    info = json.loads(manifest.read_text())
    binary = Path(info.get("binary", ""))
    if info.get("repo") != KINDS[kind]["repo"]:
        raise w.ToolError(f"{pin_dir} pins repo {info.get('repo')!r}, not {KINDS[kind]['repo']!r}")
    if info.get("kind") != kind or info.get("target") != rust_target:
        raise w.ToolError(f"{pin_dir} does not pin {kind} for {rust_target}; refusing a different binary")
    # Pins from before the field existed were all built without incremental.
    if bool(info.get("incremental", False)) != incremental:
        raise w.ToolError(f"{pin_dir} records incremental={info.get('incremental', False)}, not {incremental}; refusing a different binary")
    # A pin of another tree that was relabelled with this tree's provenance (the pre-fix
    # cross-tree reuse wrote `reused_from`): its source must be this same working state.
    source = info.get("reused_from")
    if source:
        origin = pin_dir.parent / str(source) / "manifest.json"
        try:
            origin_info = json.loads(origin.read_text())
        except (OSError, ValueError):
            raise w.ToolError(
                f"{pin_dir} says it reused {source}, whose manifest is missing or unreadable: a pin is used only when "
                "its source is the same tree; the owner must remove this pin deliberately") from None
        if (origin_info.get("head"), origin_info.get("diff_sha256")) != (info.get("head"), info.get("diff_sha256")):
            raise w.ToolError(
                f"{pin_dir} is a relabelled pin: it reused {source} built from tree "
                f"{str(origin_info.get('head'))[:12]}/diff {str(origin_info.get('diff_sha256'))[:8]}, while its manifest "
                f"claims {str(info.get('head'))[:12]}/diff {str(info.get('diff_sha256'))[:8]}; it is never used or "
                "registered — the owner must remove it deliberately")
    # Another working state means another tree, even under the same pin name.
    if before is not None and (info.get("head") is None or info.get("diff_sha256") is None):
        raise w.ToolError(f"{pin_dir} records no tree provenance (head/diff_sha256): pins without it are never used; "
                          "the owner must remove it deliberately")
    if before is not None and (info.get("head") != before["head"]
                               or info.get("diff_sha256") != before["diff_sha256"]):
        raise w.ToolError(
            f"{pin_dir} pins tree {str(info.get('head'))[:12]}/diff {str(info.get('diff_sha256'))[:8]}, not this tree "
            f"{before['head'][:12]}/diff {before['diff_sha256'][:8]}: pins are immutable and another tree's binary is "
            "never reused or relabelled; the owner must remove that pin deliberately")
    # Kinds without an input list (the client) record their build parameters separately; a pin
    # from before that record cannot be proven to match this environment, so it fails closed.
    # A client pin records its own input list too (CLIENT_INPUT_PATHS, which includes the codegen
    # environment): a pin from before that record cannot be proven to match this build.
    if kind == "client" and info.get("inputs_sha256") is None:
        raise w.ToolError(f"{pin_dir} records no build inputs (inputs_sha256): it predates the client input record, so it "
                          "is not reused — re-pin this tree, or the owner removes the pin deliberately")
    # Same head and diff but other build inputs (toolchain, RUSTFLAGS, ...): not this tree's binary.
    # Pins from before `inputs_sha256` existed carry no key and stay accepted.
    if inputs and info.get("inputs_sha256") and info["inputs_sha256"] != inputs:
        raise w.ToolError(f"{pin_dir} was built with other build inputs (toolchain or build environment changed since); "
                          "pins are immutable, so it is not reused or rebuilt: the owner must remove it deliberately")
    # Same head, diff and inputs but another value of a variable cargo tracked for the build (a build script's
    # own switch, e.g. ZSTD_SYS_USE_PKG_CONFIG). Pins from before `env_deps` existed carry no map and stay
    # accepted under their own name; reuse_pin never copies them.
    if inputs and info.get("env_deps") is not None and not env_deps_match(info["env_deps"], build_env(incremental)):
        raise w.ToolError(f"{pin_dir} was built with other values of environment variables its build tracks "
                          "(see env_deps in its manifest); pins are immutable, so it is not reused or rebuilt: "
                          "restore that environment or the owner must remove the pin deliberately")
    if not binary.is_file() or w.sha256_file(binary) != info.get("binary_sha256"):
        raise w.ToolError(f"pin {pin_dir} is damaged (binary missing or sha256 differs); pins are immutable, "
                          "so it is not rebuilt: the owner must remove it deliberately")
    return binary


def build(top: Path, kind: str, rust_target: str | None, incremental: bool,
          target: Path | None = None) -> tuple[list[str], Path]:
    """One runner build; None uses Cargo's native artifact layout, explicit targets keep their own layout.

    CARGO_INCREMENTAL is set explicitly (the runner's own default would also be on in its normal
    lane) so the manifest records exactly what was built."""
    spec = KINDS[kind]
    cmd = [str(w.MEM_RUN), "-m", spec.get("mem", "6G"), "env", f"CARGO_INCREMENTAL={int(incremental)}"]
    if target is not None:
        cmd.append(f"CARGO_TARGET_DIR={target}")
    if spec.get("test"):
        # `--no-run` builds the lib test executable and runs nothing; its path comes from
        # cargo's JSON report (`profile.test` plus `executable`), named `mc_core-<hash>`.
        cmd += ["cargo", "test", "--release", "--locked", "--no-run", "-p", spec["package"], "--lib"]
    else:
        cmd += ["cargo", "build", "--release", "--locked"]
    if rust_target is not None:
        cmd += ["--target", rust_target]
    if not spec.get("test"):
        cmd += ["-p", spec["package"], "--bin", spec["bin"]]
    cmd += ["--message-format=json-render-diagnostics"]
    env = build_env(incremental)
    # mem-run refuses a release build outside this tool (owner 2026-11-15): the pin is
    # the one place a release binary is built, and its manifest is the provenance.
    env["KRASNOKAMEN_PIN_RELEASE"] = "1"
    say(f"building: {shlex.join(cmd)} (cwd {top})")
    artifact = None
    with subprocess.Popen(cmd, cwd=top, env=env, stdout=subprocess.PIPE, text=True) as proc:
        for line in proc.stdout:
            try:
                message = json.loads(line)
            except ValueError:
                print(line, end="", file=sys.stderr)
                continue
            target_info = message.get("target") or {}
            if message.get("reason") == "compiler-artifact" and message.get("executable"):
                if spec.get("test"):
                    # The lib test executable: `profile.test` marks it, and cargo names it
                    # `mc_core-<hash>` in release/deps.
                    if (message.get("profile") or {}).get("test") and target_info.get("name") == spec["package"].replace("-", "_"):
                        artifact = Path(message["executable"])
                elif target_info.get("name") == spec["bin"] and "bin" in target_info.get("kind", []):
                    artifact = Path(message["executable"])
    if proc.returncode != 0:
        raise w.ToolError(f"build failed (exit {proc.returncode}); nothing pinned")
    if artifact is None or not artifact.is_file():
        raise w.ToolError(f"cargo reported no {spec['bin'] or spec['package']} executable; nothing pinned")
    if rust_target is None and not spec.get("test"):
        host = host_target(top)
        name = spec["bin"] + (".exe" if "windows" in host.split("-") else "")
        relative = artifact.resolve().relative_to(artifact_slot(artifact).resolve())
        if relative.parts not in (("release", name), (host, "release", name)):
            raise w.ToolError(
                f"Cargo produced {artifact}, not a native {host} artifact; "
                "use --target for a configured cross target; nothing pinned"
            )
    return cmd, artifact


def target_triple(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_.]+(?:-[A-Za-z0-9_]+)+", value):
        raise argparse.ArgumentTypeError("target must be a Rust target triple, not a path")
    return value


def host_target(top: Path) -> str:
    version = subprocess.check_output(["rustc", "-vV"], cwd=top, text=True)
    for line in version.splitlines():
        if line.startswith("host: "):
            return target_triple(line.removeprefix("host: ").strip())
    raise w.ToolError("rustc did not report its host target")


def artifact_slot(artifact: Path) -> Path:
    try:
        relative = artifact.resolve().relative_to(w.TARGETS.resolve())
    except ValueError:
        raise w.ToolError(f"{artifact} is not in a pooled target slot; nothing pinned") from None
    if not relative.parts or not relative.parts[0].startswith("slot-"):
        raise w.ToolError(f"{artifact} is not in a pooled target slot; nothing pinned")
    return w.TARGETS / relative.parts[0]


def ledger_fingerprint(top: Path) -> dict:
    """tools/harness/ledger.py's own tree_fingerprint() of `top`, imported from that tree.

    The bug ledger identifies a candidate by HEAD plus a hash of its uncommitted and untracked
    state (docs/bugs and .analysis aside) and accepts a release binary only when that binary was
    registered for exactly that fingerprint. The hash is never reimplemented here."""
    module = top / "tools/harness/ledger.py"
    if not module.is_file():
        raise w.ToolError(f"{top} has no tools/harness/ledger.py; cannot register the pin for the bug ledger")
    probe = ("import json, sys\n"
             "from tools.harness.ledger import tree_fingerprint\n"
             "print(json.dumps(tree_fingerprint(sys.argv[1])))\n")
    done = subprocess.run([sys.executable, "-c", probe, str(top)], cwd=top, capture_output=True, text=True)
    if done.returncode != 0:
        raise w.ToolError(f"{top}: ledger tree_fingerprint failed: {done.stderr.strip()[-500:]}")
    return json.loads(done.stdout.strip().splitlines()[-1])


def registers_for_ledger(kind: str) -> bool:
    """Whether a pin of `kind` belongs in ledger-builds. That registry is the *server* binary
    registry: tools/harness/ledger.py's `_server_built_from` accepts a release server for a
    candidate's real-client receipt, so a test executable's sha256 must never be registered there
    (a row could cite it as its evidence binary)."""
    return kind == "server"


def ledger_register(top: Path, binary: Path) -> None:
    """Register a server or core-tests pin where tools/harness/ledger.py looks for it.

    ledger.py writes `<candidate>/.analysis/ledger-builds/<binary sha256>.json` as
    `{"sha256": ..., "tree": {"head": ..., "sha256": ...}}` (tools/harness/ledger.py:585-589,
    `_register_server`) and `_server_built_from` reads the same directory of its `root` argument
    (tools/harness/ledger.py:592-611), with `promote`'s default `root=REPO_ROOT`
    (tools/harness/ledger.py:936). So the candidate tree is the registry root and the entry
    describes the tree the binary was built from. KRASNOKAMEN_LEDGER_ROOT names the candidate when
    the pin is built in another tree (a control); it defaults to the pinned tree."""
    if not (top / "tools/harness/ledger.py").is_file():
        # A minimal fixture tree (or a client tree) has no bug ledger: nothing can cite this binary.
        say(f"{top} has no tools/harness/ledger.py; not registering the pin for the bug ledger")
        return
    root = Path(os.environ.get("KRASNOKAMEN_LEDGER_ROOT") or top)
    tree = ledger_fingerprint(top)
    registry = root / ".analysis/ledger-builds"
    registry.mkdir(parents=True, exist_ok=True)
    sha = w.sha256_file(binary)
    (registry / f"{sha}.json").write_text(json.dumps({"sha256": sha, "tree": {"head": tree["head"], "sha256": tree["sha256"]}}) + "\n")


def main() -> None:
    parser = argparse.ArgumentParser(description="Build once, pin immutably, print the binary path env line.")
    parser.add_argument("tree", help="a worktree or repository root")
    kinds = parser.add_mutually_exclusive_group()
    kinds.add_argument("--client", action="store_true", help="pin the native client (default: the core server)")
    kinds.add_argument("--bots", action="store_true", help="pin release player-scale-bots")
    kinds.add_argument("--core-tests", action="store_true",
                       help="pin the release mc-core lib test executable (`cargo test --release --no-run -p mc-core --lib`)")
    parser.add_argument("--target", type=target_triple, help="Rust target triple (default: rustc host, not CARGO_BUILD_TARGET)")
    parser.add_argument("--no-incremental", action="store_true",
                        help="full release build for perf windows (bench, coreperf refuse incremental pins)")
    args = parser.parse_args()
    w.check_host()

    kind = "client" if args.client else "bots" if args.bots else "core-tests" if args.core_tests else "server"
    spec = KINDS[kind]
    if not Path(args.tree).is_dir():
        raise w.ToolError(f"{args.tree} is not a directory")
    top = Path(str(w.git(args.tree, "rev-parse", "--show-toplevel")))
    check_tree(top, kind)
    rust_target = args.target or host_target(top)
    # A test executable's file name is cargo's (`mc_core-<hash>`), known only after the build.
    binary_name = "" if spec.get("test") else spec["bin"] + (".exe" if "windows" in rust_target.split("-") else "")
    before = provenance(top)
    incremental = not args.no_incremental
    pin_id = f"{before['id']}-{kind}-{rust_target}" + ("-incr" if incremental else "")
    pin_dir = w.PINS / pin_id
    inputs = kind_inputs(top, before, kind, rust_target, incremental)

    def done(binary: Path, how: str) -> None:
        if registers_for_ledger(kind):
            ledger_register(top, binary)
        w.in_use_add(pin_dir, top.name, "pin")  # owner: the tree that asked for the pin
        say(f"{how}: {pin_dir.name}")
        print(f"{spec['env']}={binary}")

    w.PINS.mkdir(parents=True, exist_ok=True)
    with open(w.PINS / f".lock-{pin_id}", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # a concurrent build of the same tree is waited for, not repeated
        binary = existing_pin(pin_dir, kind, rust_target, incremental, inputs, before)
        if binary:
            return done(binary, "already pinned, not building")
        if pin_dir.exists():
            raise w.ToolError(f"{pin_dir} exists without a manifest; refusing to touch it")

        if inputs:
            reused = reuse_pin(pin_dir, top, kind, rust_target, incremental, inputs, before)
            if reused:
                return done(reused, "same build inputs as "
                            + json.loads((pin_dir / "manifest.json").read_text())["reused_from"] + ", reused its binary without building")

        cmd, artifact = build(top, kind, args.target, incremental)
        # The runner releases the slot when the build exits, and another tree may
        # then replace the artifact. Take the slot's pool lock ourselves, make sure
        # the slot holds this tree's build (rebuild under the lock: usually a no-op),
        # and copy while still holding it.
        slot = artifact_slot(artifact)
        stage = w.PINS / f".tmp-{pin_id}-{os.getpid()}"
        with open(SLOT_LOCKS / slot.name.removeprefix("slot-"), "w") as slot_lock:
            fcntl.flock(slot_lock, fcntl.LOCK_EX)  # no new owner can take the slot now
            marker = slot / ".krasnokamen-tree"
            if (marker.read_text().strip() if marker.is_file() else "") != str(top):
                # Another tree used the slot since: wait for its remaining commands (they
                # hold the use lock shared), then make cargo see this tree's sources as
                # newer, exactly as the runner does on a tree switch (slot-select.sh).
                with open(SLOT_LOCKS / f"{slot.name.removeprefix('slot-')}.use", "a") as use_lock:
                    fcntl.flock(use_lock, fcntl.LOCK_EX)
                    subprocess.run("git ls-files -z | xargs -0 -r touch -c --", shell=True, cwd=top, check=True)
                    marker.write_text(f"{top}\n")
            cmd, artifact = build(top, kind, args.target, incremental, target=slot)
            env_deps = (build_env_deps(build_env_names(artifact, slot), build_env(incremental))
                        if inputs else None)
            after = provenance(top)
            if after["tree"] != before["tree"]:
                raise w.ToolError("the tree changed during the build; the binary does not match any single provenance, nothing pinned")
            try:
                stage.mkdir()
                staged = stage / (artifact.name if spec.get("test") else binary_name)
                binary_name = staged.name
                if spec.get("test"):
                    # A test executable is hundreds of MB: a hard link pins this inode at no
                    # disk cost (cargo replaces outputs with new files, never in place).
                    try:
                        os.link(artifact, staged)
                    except OSError:
                        shutil.copyfile(artifact, staged)
                else:
                    shutil.copyfile(artifact, staged)
            except BaseException:
                shutil.rmtree(stage, ignore_errors=True)
                raise
        try:
            if not spec.get("test"):
                staged.chmod(0o555)  # a shared inode: never make the slot's artifact read-only
            binary_sha = w.sha256_file(staged)
            final_binary = pin_dir / binary_name
            manifest = {
                "repo": spec["repo"], "head": before["head"], "diff_sha256": before["diff_sha256"],
                "kind": kind, "target": rust_target, "incremental": incremental,
                "dirty": before["dirty"], "untracked_files": before["untracked_files"], "source": str(top),
                "binary": str(final_binary), "binary_sha256": binary_sha,
                "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "command": shlex.join(cmd),
            }
            if inputs:
                manifest.update(inputs_sha256=inputs, build_tree=str(top), env_deps=env_deps)
            (stage / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
            (stage / "manifest.json").chmod(0o444)
            os.rename(stage, pin_dir)  # atomic; fails rather than replacing an existing pin
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        return done(final_binary, "built and pinned")


if __name__ == "__main__":
    w.run_tool(main)
