#!/usr/bin/env python3
"""Build or reuse one immutable release pin, identified by source, binary kind and Rust target.

Owner-host tool (see tools/dev/README.md). The pin is identified by the tree's
HEAD and a hash of its uncommitted changes; the same tree is built once and every
later call prints the pinned binary. stdout carries only the final
SOLARIS_SERVER_BINARY=<path> (or SOLARIS_CLIENT_BINARY / SOLARIS_BOTS_BINARY).
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wtlib as w  # noqa: E402

KINDS = {
    "server": {"repo": "core", "package": "mc-edge", "bin": "solaris-v2", "env": "SOLARIS_SERVER_BINARY"},
    "client": {"repo": "client", "package": "solaris-client", "bin": "solaris-client", "env": "SOLARIS_CLIENT_BINARY"},
    "bots": {"repo": "core", "package": "mc-test-harness", "bin": "player-scale-bots", "env": "SOLARIS_BOTS_BINARY"},
}
# Everything a server or bots release build reads: Cargo workspace files, every crate, the guest SDK
# and the Java sources mc-edge embeds with include_str! (crates/mc-edge/src/content_import.rs, the
# only include outside crates/ and sdk/; audited 2026-11-11 over every build.rs, include_str!,
# include_bytes!, include! and env!("CARGO_MANIFEST_DIR") in crates/ and sdk/). A pin whose inputs
# match an existing pin's is that pin's binary: see reuse_pin.
INPUT_PATHS = (
    "crates", "sdk", "Cargo.toml", "Cargo.lock", ".cargo", "rust-toolchain.toml",
    "tools/extract-block-map-colors", "tools/extract-block-light", "tools/extract-block-mining",
    "tools/extract-block-explosion", "tools/VanillaWorldgenOracle.java",
)
# Environment that changes what cargo/rustc produce (build() pops the target variables itself).
BUILD_ENV = re.compile(
    r"^(RUSTFLAGS|RUSTDOCFLAGS|CARGO_ENCODED_RUSTFLAGS|RUSTC.*|CARGO_PROFILE_.*|CARGO_BUILD_.*|"
    r"CARGO_TARGET_.*|CARGO_CFG_.*|CC|CXX|CFLAGS|CXXFLAGS|LDFLAGS)$")
BUILD_ENV_IGNORED = {"CARGO_BUILD_JOBS", "CARGO_BUILD_TARGET", "CARGO_TARGET_DIR", "CARGO_INCREMENTAL"}
# mem-run's pool lock files: slot-<l> is held through /tmp/solaris-mem-slots/<l>.
SLOT_LOCKS = Path("/tmp/solaris-mem-slots")


def say(message: str) -> None:
    print(f"pin-release: {message}", file=sys.stderr)


def check_tree(top: Path, kind: str) -> None:
    if kind in ("server", "bots") and not (top / "crates/mc-edge/Cargo.toml").is_file():
        raise w.ToolError(f"{top} is not a core Solaris tree (no crates/mc-edge); use --client for the client")
    if kind == "client":
        manifest = top / "Cargo.toml"
        if not manifest.is_file() or 'name = "solaris-client"' not in manifest.read_text():
            raise w.ToolError(f"{top} is not a solaris-client tree; omit --client for the server")


def provenance(top: Path) -> dict:
    """HEAD plus a hash of the uncommitted changes (`git diff HEAD --binary`, untracked files included)."""
    head = str(w.git(top, "rev-parse", "HEAD"))
    tree, untracked = w.working_state(top)
    diff = w.git(top, "diff", "--binary", "--no-ext-diff", "--no-textconv", "--no-color", "HEAD", tree, binary=True)
    diff_sha = w.sha256_bytes(diff)
    return {
        "head": head, "tree": tree, "diff_sha256": diff_sha, "dirty": bool(diff), "untracked_files": len(untracked),
        "id": head[:12] + (f"-{diff_sha[:8]}" if diff else ""),
    }


def cargo_config_files(top: Path) -> list[Path]:
    """Existing Cargo config files outside the tree that Cargo merges into this build, in Cargo's
    precedence order: `.cargo/config[.toml]` in each parent directory (nearest first), then CARGO_HOME.
    The tree's own `.cargo/` is in INPUT_PATHS. Only existing files count and the key uses their
    contents, not their paths, so identical trees at different depths (main and wt/<name>) share a key
    while a config appearing anywhere above either changes it."""
    home = Path(os.environ.get("CARGO_HOME") or Path.home() / ".cargo")
    found: list[Path] = []
    for directory in [parent / ".cargo" for parent in top.resolve().parents] + [home]:
        for name in ("config.toml", "config"):
            path = (directory / name).resolve()
            if path.is_file() and path not in found:
                found.append(path)
    return found


def inputs_sha256(top: Path, tree: str, kind: str, rust_target: str, incremental: bool) -> str:
    """Digest of everything the build reads, from the tree object of the working state.

    `tree` is wtlib.working_state's tree (HEAD plus uncommitted and untracked non-ignored files), so a
    tracked, dirty or untracked change inside INPUT_PATHS changes the key and one outside does not.
    Ignored files are not part of it (nothing in the audited includes reads one)."""
    parts = [f"{path}={w.git(top, 'rev-parse', '--verify', '--quiet', f'{tree}:{path}', check=False) or 'absent'}"
             for path in INPUT_PATHS]
    parts.append("rustc=" + str(subprocess.check_output(["rustc", "-vV"], cwd=top, text=True)).strip())
    parts += [f"env.{name}={value}" for name, value in sorted(os.environ.items())
              if BUILD_ENV.match(name) and name not in BUILD_ENV_IGNORED]
    parts += [f"cargo_config={w.sha256_file(path)}" for path in cargo_config_files(top)]
    parts += [f"target={rust_target}", f"kind={kind}", f"incremental={int(incremental)}"]
    return w.sha256_bytes("\n".join(parts).encode())


def reuse_pin(pin_dir: Path, top: Path, kind: str, rust_target: str, incremental: bool, inputs: str,
              before: dict) -> Path | None:
    """Create `pin_dir` from an existing pin with the same build inputs, without building, or return None.

    Candidates are valid pins only (same repo/kind/target/incremental, binary present with its recorded
    sha256); a damaged one is skipped, never repaired. The binary is hard-linked (copied if linking
    fails) and the manifest records this tree's provenance, the shared inputs and `reused_from`. A bots pin
    is reused only by the tree that built it (see below)."""
    spec = KINDS[kind]
    for candidate in sorted(w.PINS.glob("*/manifest.json")):
        try:
            info = json.loads(candidate.read_text())
        except (OSError, ValueError):
            continue
        source_dir = candidate.parent
        if (info.get("inputs_sha256") != inputs or info.get("repo") != spec["repo"] or info.get("kind") != kind
                or info.get("target") != rust_target or bool(info.get("incremental", False)) != incremental):
            continue
        binary = Path(info.get("binary", ""))
        if binary.parent != source_dir or not binary.is_file() or w.sha256_file(binary) != info.get("binary_sha256"):
            continue
        if kind == "bots" and info.get("build_tree") != str(top):
            # player-scale-bots reads <build tree>/data/vanilla/reports at every run (CARGO_MANIFEST_DIR is baked
            # in): a copy built in another tree stops working when that tree is removed. Reuse only your own.
            continue
        stage = w.PINS / f".tmp-{pin_dir.name}-{os.getpid()}"
        try:
            stage.mkdir()
            staged = stage / binary.name
            try:
                os.link(binary, staged)
            except OSError:
                shutil.copyfile(binary, staged)
                staged.chmod(0o555)
            manifest = {
                "repo": spec["repo"], "head": before["head"], "diff_sha256": before["diff_sha256"],
                "kind": kind, "target": rust_target, "incremental": incremental,
                "dirty": before["dirty"], "untracked_files": before["untracked_files"], "source": str(top),
                "binary": str(pin_dir / binary.name), "binary_sha256": info["binary_sha256"],
                "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "command": info.get("command", ""),
                "inputs_sha256": inputs, "build_tree": info.get("build_tree"), "reused_from": source_dir.name,
            }
            (stage / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
            (stage / "manifest.json").chmod(0o444)
            os.rename(stage, pin_dir)
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        return pin_dir / binary.name
    return None


def existing_pin(pin_dir: Path, kind: str, rust_target: str, incremental: bool,
                 inputs: str | None = None) -> Path | None:
    """The binary of a valid existing pin, or None; a damaged pin is an error (pins are never overwritten)."""
    manifest = pin_dir / "manifest.json"
    if not manifest.is_file():
        return None
    info = json.loads(manifest.read_text())
    binary = Path(info.get("binary", ""))
    if info.get("repo") != KINDS[kind]["repo"]:
        raise w.ToolError(f"{pin_dir} pins repo {info.get('repo')!r}, not {KINDS[kind]['repo']!r}")
    if info.get("kind") != kind or info.get("target") != rust_target:
        raise w.ToolError(f"{pin_dir} does not pin {kind} for {rust_target}; refusing a different binary")
    # Pins from before the field existed were all built without incremental.
    if bool(info.get("incremental", False)) != incremental:
        raise w.ToolError(f"{pin_dir} records incremental={info.get('incremental', False)}, not {incremental}; refusing a different binary")
    # Same head and diff but other build inputs (toolchain, RUSTFLAGS, ...): not this tree's binary.
    # Pins from before `inputs_sha256` existed carry no key and stay accepted.
    if inputs and info.get("inputs_sha256") and info["inputs_sha256"] != inputs:
        raise w.ToolError(f"{pin_dir} was built with other build inputs (toolchain or build environment changed since); "
                          "pins are immutable, so it is not reused or rebuilt: the owner must remove it deliberately")
    if not binary.is_file() or w.sha256_file(binary) != info.get("binary_sha256"):
        raise w.ToolError(f"pin {pin_dir} is damaged (binary missing or sha256 differs); pins are immutable, "
                          "so it is not rebuilt: the owner must remove it deliberately")
    return binary


def build(top: Path, kind: str, rust_target: str | None, incremental: bool,
          target: Path | None = None) -> tuple[list[str], Path]:
    """One runner build; None uses Cargo's native artifact layout, explicit targets keep their own layout.

    CARGO_INCREMENTAL is set explicitly (the runner's own default would also be on in its normal
    lane) so the manifest records exactly what was built."""
    spec = KINDS[kind]
    cmd = [str(w.MEM_RUN), "-m", "6G", "env", f"CARGO_INCREMENTAL={int(incremental)}"]
    if target is not None:
        cmd.append(f"CARGO_TARGET_DIR={target}")
    cmd += ["cargo", "build", "--release", "--locked"]
    if rust_target is not None:
        cmd += ["--target", rust_target]
    cmd += ["-p", spec["package"], "--bin", spec["bin"], "--message-format=json-render-diagnostics"]
    env = dict(os.environ)
    env.pop("CARGO_TARGET_DIR", None)
    env.pop("CARGO_BUILD_TARGET", None)
    say(f"building: {shlex.join(cmd)} (cwd {top})")
    artifact = None
    with subprocess.Popen(cmd, cwd=top, env=env, stdout=subprocess.PIPE, text=True) as proc:
        for line in proc.stdout:
            try:
                message = json.loads(line)
            except ValueError:
                print(line, end="", file=sys.stderr)
                continue
            target_info = message.get("target") or {}
            if (message.get("reason") == "compiler-artifact" and target_info.get("name") == spec["bin"]
                    and "bin" in target_info.get("kind", []) and message.get("executable")):
                artifact = Path(message["executable"])
    if proc.returncode != 0:
        raise w.ToolError(f"build failed (exit {proc.returncode}); nothing pinned")
    if artifact is None or not artifact.is_file():
        raise w.ToolError(f"cargo reported no {spec['bin']} executable; nothing pinned")
    if rust_target is None:
        host = host_target(top)
        name = spec["bin"] + (".exe" if "windows" in host.split("-") else "")
        relative = artifact.resolve().relative_to(artifact_slot(artifact).resolve())
        if relative.parts not in (("release", name), (host, "release", name)):
            raise w.ToolError(
                f"Cargo produced {artifact}, not a native {host} artifact; "
                "use --target for a configured cross target; nothing pinned"
            )
    return cmd, artifact


def target_triple(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_.]+(?:-[A-Za-z0-9_]+)+", value):
        raise argparse.ArgumentTypeError("target must be a Rust target triple, not a path")
    return value


def host_target(top: Path) -> str:
    version = subprocess.check_output(["rustc", "-vV"], cwd=top, text=True)
    for line in version.splitlines():
        if line.startswith("host: "):
            return target_triple(line.removeprefix("host: ").strip())
    raise w.ToolError("rustc did not report its host target")


def artifact_slot(artifact: Path) -> Path:
    try:
        relative = artifact.resolve().relative_to(w.TARGETS.resolve())
    except ValueError:
        raise w.ToolError(f"{artifact} is not in a pooled target slot; nothing pinned") from None
    if not relative.parts or not relative.parts[0].startswith("slot-"):
        raise w.ToolError(f"{artifact} is not in a pooled target slot; nothing pinned")
    return w.TARGETS / relative.parts[0]


def main() -> None:
    parser = argparse.ArgumentParser(description="Build once, pin immutably, print the binary path env line.")
    parser.add_argument("tree", help="a worktree or repository root")
    kinds = parser.add_mutually_exclusive_group()
    kinds.add_argument("--client", action="store_true", help="pin the native client (default: the core server)")
    kinds.add_argument("--bots", action="store_true", help="pin release player-scale-bots")
    parser.add_argument("--target", type=target_triple, help="Rust target triple (default: rustc host, not CARGO_BUILD_TARGET)")
    parser.add_argument("--no-incremental", action="store_true",
                        help="full release build for perf windows (bench, coreperf refuse incremental pins)")
    args = parser.parse_args()
    w.check_host()

    kind = "client" if args.client else "bots" if args.bots else "server"
    spec = KINDS[kind]
    if not Path(args.tree).is_dir():
        raise w.ToolError(f"{args.tree} is not a directory")
    top = Path(str(w.git(args.tree, "rev-parse", "--show-toplevel")))
    check_tree(top, kind)
    rust_target = args.target or host_target(top)
    binary_name = spec["bin"] + (".exe" if "windows" in rust_target.split("-") else "")
    before = provenance(top)
    incremental = not args.no_incremental
    pin_id = f"{before['id']}-{kind}-{rust_target}" + ("-incr" if incremental else "")
    pin_dir = w.PINS / pin_id
    inputs = inputs_sha256(top, before["tree"], kind, rust_target, incremental) if kind in ("server", "bots") else None

    def done(binary: Path, how: str) -> None:
        w.in_use_add(pin_dir, top.name, "pin")  # owner: the tree that asked for the pin
        say(f"{how}: {pin_dir.name}")
        print(f"{spec['env']}={binary}")

    w.PINS.mkdir(parents=True, exist_ok=True)
    with open(w.PINS / f".lock-{pin_id}", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # a concurrent build of the same tree is waited for, not repeated
        binary = existing_pin(pin_dir, kind, rust_target, incremental, inputs)
        if binary:
            return done(binary, "already pinned, not building")
        if pin_dir.exists():
            raise w.ToolError(f"{pin_dir} exists without a manifest; refusing to touch it")

        if inputs:
            reused = reuse_pin(pin_dir, top, kind, rust_target, incremental, inputs, before)
            if reused:
                return done(reused, "same build inputs as "
                            + json.loads((pin_dir / "manifest.json").read_text())["reused_from"] + ", reused its binary without building")

        cmd, artifact = build(top, kind, args.target, incremental)
        # The runner releases the slot when the build exits, and another tree may
        # then replace the artifact. Take the slot's pool lock ourselves, make sure
        # the slot holds this tree's build (rebuild under the lock: usually a no-op),
        # and copy while still holding it.
        slot = artifact_slot(artifact)
        stage = w.PINS / f".tmp-{pin_id}-{os.getpid()}"
        with open(SLOT_LOCKS / slot.name.removeprefix("slot-"), "w") as slot_lock:
            fcntl.flock(slot_lock, fcntl.LOCK_EX)  # no new owner can take the slot now
            marker = slot / ".solaris-tree"
            if (marker.read_text().strip() if marker.is_file() else "") != str(top):
                # Another tree used the slot since: wait for its remaining commands (they
                # hold the use lock shared), then make cargo see this tree's sources as
                # newer, exactly as the runner does on a tree switch (slot-select.sh).
                with open(SLOT_LOCKS / f"{slot.name.removeprefix('slot-')}.use", "a") as use_lock:
                    fcntl.flock(use_lock, fcntl.LOCK_EX)
                    subprocess.run("git ls-files -z | xargs -0 -r touch -c --", shell=True, cwd=top, check=True)
                    marker.write_text(f"{top}\n")
            cmd, artifact = build(top, kind, args.target, incremental, target=slot)
            after = provenance(top)
            if after["tree"] != before["tree"]:
                raise w.ToolError("the tree changed during the build; the binary does not match any single provenance, nothing pinned")
            try:
                stage.mkdir()
                staged = stage / binary_name
                shutil.copyfile(artifact, staged)
            except BaseException:
                shutil.rmtree(stage, ignore_errors=True)
                raise
        try:
            staged.chmod(0o555)
            binary_sha = w.sha256_file(staged)
            final_binary = pin_dir / binary_name
            manifest = {
                "repo": spec["repo"], "head": before["head"], "diff_sha256": before["diff_sha256"],
                "kind": kind, "target": rust_target, "incremental": incremental,
                "dirty": before["dirty"], "untracked_files": before["untracked_files"], "source": str(top),
                "binary": str(final_binary), "binary_sha256": binary_sha,
                "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "command": shlex.join(cmd),
            }
            if inputs:
                manifest.update(inputs_sha256=inputs, build_tree=str(top))
            (stage / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
            (stage / "manifest.json").chmod(0o444)
            os.rename(stage, pin_dir)  # atomic; fails rather than replacing an existing pin
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        return done(final_binary, "built and pinned")


if __name__ == "__main__":
    w.run_tool(main)
