#!/usr/bin/env bash
# The shared real-client stand (owner D150). Source it, do not build a client per row:
#   . tools/dev/client-stand || { echo "stand unavailable" >&2; handle_it; }
#   python3 -m tools.harness run scenario <id> --client native --windowed
# Every lane that needs a live client takes its runs from these paths.
#
# Sourced-safe (owner D153): sourcing must not change the caller's shell options
# and must not end the caller; a missing path returns 1 instead of exiting.

W=${SOLARIS_WORK:-/run/media/kaiserroman/games/solaris-work}
# Stand pin: published client commit f08b751b2a48c9e3c709c1991ff90a70f2afcb63.
# Binary SHA-256: 2d7188111453f04f1aa6d561a208cc62bdb8b2c4b2eb1319e2c78417451731e3.
# It carries the received-passenger observer and bounded boat ground scan.
# Frozen fallback: the c879f0ae38b7 pin
# (…/pins/c879f0ae38b7-client-x86_64-unknown-linux-gnu-incr/krasnokamen-client); receipts
# already produced with it stay valid for their own control/candidate pair.
export KRASNOKAMEN_CLIENT_BINARY=$W/pins/f08b751b2a48-client-x86_64-unknown-linux-gnu-incr/krasnokamen-client
export KRASNOKAMEN_CLIENT_DATA_DIR=$W/qa-armada/template-data/data/vanilla
export KRASNOKAMEN_CLIENT_RESOURCE_ROOT=$W/qa-armada/template-data/resources
export KRASNOKAMEN_CLIENT_ASSET_ROOT=$W/qa-armada/template-data/assets
export KRASNOKAMEN_CLIENT_ASSET_INDEX=$W/qa-armada/template-data/assets/asset-index.json

client_stand_paths() {
    local v p
    for v in KRASNOKAMEN_CLIENT_BINARY KRASNOKAMEN_CLIENT_DATA_DIR KRASNOKAMEN_CLIENT_RESOURCE_ROOT \
             KRASNOKAMEN_CLIENT_ASSET_ROOT KRASNOKAMEN_CLIENT_ASSET_INDEX; do
        p=${!v}
        if [ ! -e "$p" ]; then
            echo "client-stand: $v is missing at $p" >&2
            return 1
        fi
    done
    echo "client-stand: $KRASNOKAMEN_CLIENT_BINARY (data $KRASNOKAMEN_CLIENT_DATA_DIR)" >&2
    return 0
}

# Run directly: strict mode and a real exit code. Sourced: no option changes,
# and a failure returns 1 so the caller keeps control.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    set -euo pipefail
    client_stand_paths || exit 1
else
    client_stand_paths || return 1
fi
