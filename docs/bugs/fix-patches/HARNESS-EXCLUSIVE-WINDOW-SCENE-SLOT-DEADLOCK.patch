diff --git a/tools/dev/mem-run.sh b/tools/dev/mem-run.sh
index d59fe18ec..37f5341b3 100755
--- a/tools/dev/mem-run.sh
+++ b/tools/dev/mem-run.sh
@@ -187,6 +187,11 @@ if [ "$exclusive" = 1 ]; then
   # One window at a time; while it holds this lock new commands wait at start.
   exec 3>"$dir/exclusive.lock"
   flock 3 9>&-
+  # Lock order: a scene slot (scene-slot.sh) is taken before this lock, never inside the
+  # window. Gates hold scene slots while they wait for this lock (shared), so a window
+  # command waiting for a slot deadlocked the whole fleet for ~50 min (2026-11-14).
+  # Descendants see the marker; scene-slot.sh then only reuses an inherited slot.
+  export KRASNOKAMEN_EXCLUSIVE_WINDOW=$$
   # Opened before the watchdog is told, so its "quiet" line cannot be lost.
   [ -p "$dir/quiet" ] || { rm -f "$dir/quiet"; mkfifo "$dir/quiet"; }
   exec 4<>"$dir/quiet"
diff --git a/tools/dev/scene-slot.sh b/tools/dev/scene-slot.sh
index 1af998858..4af8a0371 100755
--- a/tools/dev/scene-slot.sh
+++ b/tools/dev/scene-slot.sh
@@ -19,6 +19,21 @@
 [ $# -gt 0 ] || { echo "usage: scene-slot.sh <command> [args...]" >&2; exit 1; }
 here=$(cd "$(dirname "$0")" && pwd)
 dir=${KRASNOKAMEN_SCENE_SLOT_DIR:-/tmp}  # tests use a private dir
+slot_ancestor() {
+  want=${KRASNOKAMEN_SCENE_SLOT_PID:-}
+  case $want in ''|*[!0-9]*) return 1 ;; esac
+  p=$$
+  while [ "${p:-0}" -gt 1 ]; do
+    [ "$p" = "$want" ] && return 0
+    p=$(awk '$1 == "PPid:" {print $2}' "/proc/$p/status" 2>/dev/null) || p=0
+  done
+  return 1
+}
+[ -n "${KRASNOKAMEN_SCENE_SLOT:-}" ] && slot_ancestor && exec "$@"
+if [ -n "${KRASNOKAMEN_EXCLUSIVE_WINDOW:-}" ]; then
+  echo "scene-slot: refused inside mem-run -x window $KRASNOKAMEN_EXCLUSIVE_WINDOW (lock order: take the slot first, scene-slot.sh mem-run.sh -x <command>)" >&2
+  exit 75
+fi
 exec python3 "$here/slot-lock.py" --dir "$dir" --name 'solaris-scene-slot-%s.lock' --slots a,b \
   --env KRASNOKAMEN_SCENE_SLOT --wait-dir "$dir/solaris-scene-slot-wait" \
   --wait-message "scene-slot: both scene slots are in use; waiting for one (holders: $here/fleet-status)" \
