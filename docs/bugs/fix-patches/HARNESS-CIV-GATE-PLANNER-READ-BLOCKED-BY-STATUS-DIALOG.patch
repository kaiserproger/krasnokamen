+def _screen_on_top(probe: ProbeSteps) -> str | None:
+    """The screen class covering the game view, or None when the game view is shown."""
+    try:
+        screen = (probe.observe() or {}).get("screen") or {}
+    except Exception:
+        return None
+    if not screen.get("open"):
+        return None
+    return str(screen.get("class") or "screen")
+
+
+def _clear_covering_screen(probe: ProbeSteps) -> str | None:
+    """Close a screen left over the game view; return the class that survived the close."""
+    covering = _screen_on_top(probe)
+    if covering is None:
+        return None
+    probe.call("minecraft_close_screen", {})
+    probe.call("minecraft_wait_ticks", {"ticks": 10})
+    return _screen_on_top(probe)
+
+
