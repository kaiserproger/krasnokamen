+/// Whether this village's 20-tick gates run now. The clock is the village's
+/// own, so a fixed batch rotation cannot starve a turn of the tick-numbered
+/// gate. Extraction keeps `advance`'s work at a fixed four villages a tick.
+fn gate_due(next_gate: &mut u64, tick: u64) -> bool {
+    if *next_gate > tick {
+        return false;
+    }
+    *next_gate = tick.saturating_add(20);
+    true
 }
 
