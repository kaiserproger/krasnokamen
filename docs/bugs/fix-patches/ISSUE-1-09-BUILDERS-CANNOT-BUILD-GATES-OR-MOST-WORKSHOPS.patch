+/// certificate never inspects.
+#[test]
+fn gate_level_one_is_built_cell_for_cell_in_every_rotation() {
+    for rotation in 0..4 {
+        let (mut state, id, slot) = fixture();
+        assert!(begin(
+            &mut state,
+            Project {
+                settlement: id,
+                blueprint: "gate".into(),
+                level: 1,
