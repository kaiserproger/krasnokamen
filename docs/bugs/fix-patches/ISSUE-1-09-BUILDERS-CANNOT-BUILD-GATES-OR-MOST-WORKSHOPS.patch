@@ -35,7 +35,8 @@ pub(crate) const PAVED: &str = "paved";
 
 /// First lot row, counted from a road centre line (road ±1, verge 2).
 const LOT_FRONT: i32 = 3;
-/// Deepest lot: the largest blueprint extent, on either axis.
