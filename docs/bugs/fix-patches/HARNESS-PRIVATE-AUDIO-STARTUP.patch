+    echo "ABORT: private PipeWire socket did not become ready; see pipewire.log" >&2
+    exit 3
+  fi
+  if ! timeout 30 pw-dump >/dev/null; then
+    echo "ABORT: private PipeWire registry is unavailable; see pipewire.log" >&2
