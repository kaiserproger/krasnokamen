+        )
+        .with(
+            "pending_level",
+            Tag::String(pending.map_or(0, |order| order.level).to_string()),
+        )
+        .with(
+            "pending_building",
+            Tag::String(
+                pending
+                    .and_then(|order| order.building)
+                    .map_or(0, |id| id.0)
+                    .to_string(),
+            ),
+        )
+}
