+            Target::Job(job.id.clone()),
+        );
+    }
+    navigation(&mut screen, state, ctx, page, pages, |page| {
+        View::Production { page }
+    });
+    if ctx.manage {
+        screen.put(
+            ACTION,
+            icon(
+                state,
+                Icon::CraftingTable,
