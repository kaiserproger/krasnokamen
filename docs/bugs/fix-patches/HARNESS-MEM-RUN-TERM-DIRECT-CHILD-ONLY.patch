+    # every TERM into KeyboardInterrupt) and cut a result.json write, so skip it and this wrapper.
+    if [ "$pid" = "$$" ] || [ "$pid" = "$c" ]; then continue; fi
+    kill -TERM "$pid" 2>/dev/null || true
+  done
