             select.select([wrapper_fd, caller_fd], [], [])
-        if done or any(key.fd in (wrapper_fd, caller_fd) for key, _ in events):
+        if done or escalated or any(key.fd in (wrapper_fd, caller_fd) for key, _ in events):
