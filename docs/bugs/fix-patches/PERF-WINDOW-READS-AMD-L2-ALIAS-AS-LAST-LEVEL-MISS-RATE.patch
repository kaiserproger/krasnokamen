diff --git a/tools/dev/perf-window.sh b/tools/dev/perf-window.sh
new file mode 100755
index 000000000..fc98963a2
--- /dev/null
+++ b/tools/dev/perf-window.sh
@@ -0,0 +1,76 @@
+#!/usr/bin/env bash
+# perf-window.sh <pid> [seconds] [outdir] — one maintained perf capture of a running server.
+#
+# Maintained home for the box recipe that used to live only in receipts/Perf1M/perf-window.sh
+# (PERF-WINDOW-HAS-NO-CALL-GRAPH-AND-NO-MAINTAINED-SCRIPT) with the AMD last-level events instead
+# of the generic L2 aliases (PERF-WINDOW-READS-AMD-L2-ALIAS-AS-LAST-LEVEL-MISS-RATE).
+#
+# What it does, in one window order and with one fixed counter set so the next capture is
+# comparable:
+#   1. perf stat -M PipelineL1 --per-thread  -> stat-topdown.txt (the top-down verdict) and
+#      perf stat -x, over the explicit counter set -> stat.csv (its last column is the
+#      enabled/running percentage, so multiplexing is visible);
+#   2. perf record -g --call-graph fp --per-thread over the same counters -> perf.data;
+#   3. perf report --stdio -g "graph,0.5,caller,0.5" (inclusive callers), a self-time report and
+#      perf script (flame-graph input) -> callgraph.txt, self.txt, script.txt.
+#
+# Refusals (exit 2, nothing captured): a missing pid, a pid that is not running, a non-Linux host,
+# no perf, or a CUDA-less `perf` that cannot open events. Run the server from a pin-release built
+# with RUSTFLAGS="-C force-frame-pointers=yes": without frame pointers the call graph is useless
+# and the script says so (it checks the binary's DWARF? no: it states the requirement and fails
+# when the report has no caller frames).
+set -euo pipefail
+
+usage() { echo "usage: perf-window.sh <pid> [seconds] [outdir]" >&2; exit 2; }
+[ $# -ge 1 ] || usage
+pid=$1
+seconds=${2:-60}
+out=${3:-.analysis/perf-window-$(date -u +%Y%m%dT%H%M%SZ)}
+[[ $pid =~ ^[0-9]+$ ]] || { echo "perf-window: '$pid' is not a pid" >&2; exit 2; }
+[[ $seconds =~ ^[0-9]+$ ]] && [ "$seconds" -ge 1 ] || { echo "perf-window: seconds must be a positive integer" >&2; exit 2; }
+[ -d "/proc/$pid" ] || { echo "perf-window: no process $pid" >&2; exit 2; }
+[ "$(uname -s)" = Linux ] || { echo "perf-window: Linux only" >&2; exit 2; }
+command -v perf >/dev/null || { echo "perf-window: perf not found" >&2; exit 2; }
+
+# The explicit AMD events first: `cache-references`/`cache-misses` alias to L2 on AMD64 and must
+# never be quoted as last-level numbers again.
+events=(ls_dmnd_fills_from_sys.all l2_request_g1.all l2_misses.all cycles instructions)
+mkdir -p "$out"
+
+{
+  echo "# perf-window $(date -u +%Y-%m-%dT%H:%M:%SZ) pid=$pid seconds=$seconds"
+  echo "# events: ${events[*]}"
+  echo "# command: $0 $*"
+  echo "# kernel: $(uname -r)"
+  perf --version 2>/dev/null || true
+  echo "# requirement: server built with RUSTFLAGS=-C force-frame-pointers=yes (call graph)"
+} > "$out/header.txt"
+
+# 1. Saturation/top-down first (cheap, no call graph), then the sampling record.
+perf stat -M PipelineL1 --per-thread -p "$pid" -- sleep "$seconds" > "$out/stat-topdown.txt" 2>&1 || {
+  echo "perf-window: perf stat -M PipelineL1 failed (the host must advertise PipelineL1); see $out/stat-topdown.txt" >&2
+  exit 2
+}
+perf stat -x, -e "$(IFS=,; echo "${events[*]}")" --per-thread -p "$pid" -- sleep "$seconds" > "$out/stat.csv" 2>&1 || {
+  echo "perf-window: perf stat over the explicit counters failed; see $out/stat.csv" >&2
+  exit 2
+}
+
+# 2. Sampled call graph with frame pointers.
+perf record -p "$pid" -F 999 -g --call-graph fp --per-thread -e "$(IFS=,; echo "${events[*]}")" \
+  -o "$out/perf.data" -- sleep "$seconds" > "$out/record.log" 2>&1 || {
+  echo "perf-window: perf record failed; see $out/record.log" >&2
+  exit 2
+}
+
+# 3. Inclusive callers, self time, and the raw stream for flame graphs.
+perf report -i "$out/perf.data" --stdio --no-children -g "graph,0.5,caller,0.5" > "$out/callgraph.txt" 2>&1
+perf report -i "$out/perf.data" --stdio --no-children > "$out/self.txt" 2>&1
+perf script -i "$out/perf.data" > "$out/script.txt" 2>&1
+
+# A self-time-only capture cannot say which caller causes the fills: refuse to call it a window.
+if ! grep -qE '^ *[|+]-{1,2}' "$out/callgraph.txt"; then
+  echo "perf-window: the call graph has no caller frames (rebuild the server with RUSTFLAGS=-C force-frame-pointers=yes and rerun); files in $out" >&2
+  exit 2
+fi
+echo "perf-window: capture complete: $out" >&2
