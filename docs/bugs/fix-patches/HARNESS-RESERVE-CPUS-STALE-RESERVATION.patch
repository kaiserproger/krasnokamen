diff --git a/tools/dev/mem-run.sh b/tools/dev/mem-run.sh
index 685041ce0..a674207c2 100755
--- a/tools/dev/mem-run.sh
+++ b/tools/dev/mem-run.sh
@@ -373,8 +373,26 @@ fi
 [ "$exclusive" = 1 ] && { niceness=0; cpu_pin=(); preemptible=0; }
 # CPUs held by tools/dev/reserve-cpus (owner 2026-11-16, Spain trials) stay out of every
 # new scope except one started with KRASNOKAMEN_RESERVED_CPUS=use; running scopes keep
-# their placement, and the reservation ends with the command that holds it.
-reserved=$(cat "$dir/reserved-cpus" 2>/dev/null || true)
+# their placement, and the reservation ends with the command that holds it. A reservation
+# whose owner died (SIGKILL, OOM, a wrapper kill) is a corpse: say so and clear it, never
+# silently pin every later scope away from those CPUs (or drop the restriction when the
+# stale list covers a whole pool) — #G4, CS341. A one-line file from an older writer has no
+# owner and is honoured as-is (mixed-version compatibility).
+reserved=
+if [ -e "$dir/reserved-cpus" ]; then
+  verdict=$(python3 "$here/reserved_cpus.py" verdict "$dir" 2>/dev/null || echo none)
+  case "$verdict" in
+    keep\ *) reserved=${verdict#keep } ;;
+    stale\ *)
+      echo "mem-run: ignoring stale CPU reservation '${verdict#stale }' (its owner is gone or its pid was reused); clearing $dir/reserved-cpus" >&2
+      python3 "$here/reserved_cpus.py" clear "$dir" >&2 || true
+      # Clearing re-reads under the lock, so it never removes a reservation written meanwhile:
+      # if one is there now, it is live and this scope honours it.
+      verdict=$(python3 "$here/reserved_cpus.py" verdict "$dir" 2>/dev/null || echo none)
+      [ "${verdict%% *}" = keep ] && reserved=${verdict#keep }
+      ;;
+  esac
+fi
 if [ -n "$reserved" ] && [ "${KRASNOKAMEN_RESERVED_CPUS:-}" != use ] && [ "$exclusive" = 0 ]; then
   declare -A held=()
   for part in ${reserved//,/ }; do for ((c = ${part%-*}; c <= ${part#*-}; c++)); do held[$c]=1; done; done
diff --git a/tools/dev/reserve-cpus b/tools/dev/reserve-cpus
index 99dcc2035..edddd0b5d 100755
--- a/tools/dev/reserve-cpus
+++ b/tools/dev/reserve-cpus
@@ -6,9 +6,19 @@
 # mem-run scope started while <command> runs, then give them back. A command
 # that should use the reserved CPUs (the Spain trial servers) runs mem-run with
 # KRASNOKAMEN_RESERVED_CPUS=use. Scopes already running keep their placement.
+#
+# The file is two lines: the CPU list, then the owner's `pid starttime` (field 22
+# of /proc/<pid>/stat). A killed run leaves the file behind; mem-run and this
+# script read the owner to tell a live reservation from a corpse (pid gone or
+# reused), so a stale file cannot silently pin every later scope (#G4, CS341).
+# Clearing a corpse and creating a reservation are serialized on
+# `reserved-cpus.lock` (tools/dev/reserved_cpus.py): a reservation written while a
+# corpse is judged is never removed. Install order on a host: mem-run.sh first,
+# then this script; only the new pair is race-safe together.
 set -euo pipefail
 dir=/tmp/solaris-mem-slots
 file=$dir/reserved-cpus
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
 [ $# -ge 3 ] && [ "$2" = -- ] || { echo "usage: reserve-cpus <cpu-list> -- <command> [args...]" >&2; exit 2; }
 cpus=$1; shift 2
 [[ $cpus =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || { echo "reserve-cpus: invalid CPU list '$cpus'" >&2; exit 2; }
@@ -17,12 +27,36 @@ for part in ${cpus//,/ }; do
   [ "${part#*-}" -lt "$ncpu" ] && [ "${part%-*}" -lt "$ncpu" ] || { echo "reserve-cpus: CPU in '$part' is not below $ncpu" >&2; exit 2; }
 done
 mkdir -p "$dir"
-# noclobber makes the create atomic: a second reservation is refused, not merged.
-if ! (set -o noclobber; printf '%s\n' "$cpus" > "$file") 2>/dev/null; then
+# A reservation whose owner is gone (SIGKILL, OOM, a wrapper kill) is a corpse: name it and
+# clear it instead of refusing every future reservation behind it. The helper re-reads under
+# the lock and unlinks only the bytes it judged, so a fresh reservation is never removed.
+case "$(python3 "$here/reserved_cpus.py" verdict "$dir")" in
+  stale\ *) python3 "$here/reserved_cpus.py" clear "$dir" || true ;;
+esac
+version=$(awk '{print $22}' "/proc/$$/stat")
+# noclobber inside the lock makes the create atomic: a second reservation is refused, not merged.
+if ! (
+  exec {lf}<>"$dir/reserved-cpus.lock"
+  flock "$lf"
+  set -o noclobber
+  printf '%s\n%s %s\n' "$cpus" "$$" "$version" > "$file"
+) 2>/dev/null; then
   echo "reserve-cpus: CPUs already reserved: $(cat "$file" 2>/dev/null)" >&2
   exit 75
 fi
-release() { rm -f "$file"; echo "reserve-cpus: released $cpus" >&2; }
+starttime=$version
+release() {
+  local content expected
+  (
+    exec {lf}<>"$dir/reserved-cpus.lock"
+    flock "$lf"
+    content=$(cat "$file" 2>/dev/null || true)
+    expected=$(printf '%s\n%s %s' "$cpus" "$$" "$starttime")
+    # Only our own file: a reservation that replaced it is not ours to remove.
+    if [ "$content" = "$expected" ]; then rm -f -- "$file"; fi
+  )
+  echo "reserve-cpus: released $cpus" >&2
+}
 trap release EXIT
 trap 'exit 130' INT
 trap 'exit 143' TERM
