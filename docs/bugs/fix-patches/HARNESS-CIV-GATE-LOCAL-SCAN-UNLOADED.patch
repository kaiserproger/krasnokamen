+def _wait_scan_loaded(probe: ProbeSteps, lo: list[int], hi: list[int]) -> None:
+    """Wait, event-driven, until the client holds every chunk the scan will read.
+
+    `minecraft_wait_for_loaded_block` blocks on the client's own chunk event; it
+    is the same wait the remote branch always used, now applied to local scans
+    too, because locality is about the observer's distance, not about whether the
+    client has streamed the chunk yet.
+    """
+    for x in range(lo[0] // 16, hi[0] // 16 + 1):
+        for z in range(lo[2] // 16, hi[2] // 16 + 1):
+            probe.call("minecraft_wait_for_loaded_block", {
+                "x": max(lo[0], x * 16), "y": lo[1], "z": max(lo[2], z * 16),
+                "timeout_seconds": min(120.0, probe.remaining()),
+            })
+
