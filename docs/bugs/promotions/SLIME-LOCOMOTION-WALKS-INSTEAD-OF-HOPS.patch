diff --git a/crates/mc-core/src/entity_motion.rs b/crates/mc-core/src/entity_motion.rs
--- a/crates/mc-core/src/entity_motion.rs
+++ b/crates/mc-core/src/entity_motion.rs
@@ -489,6 +489,47 @@
     let carried = body.velocity;
     body.velocity.x = input.drive[0] + impulse[0];
     body.velocity.z = input.drive[2] + impulse[1];
+    if input.hops {
+        if body.on_ground {
+            if hop_due(
+                input.id,
+                input.tick,
+                input.hop_delay_scale,
+                input.hop_aggressive,
+            ) {
+                // `LivingEntity.jumpFromGround`/`MagmaCube.jumpFromGround`: the
+                // tick that jumps keeps the wanted horizontal speed and stores
+                // `getJumpPower()` (+ magma's `size * 0.1`), which the vanilla
+                // travel moves *before* its gravity and 0.98 drag. This kernel
+                // subtracts gravity and drags before the move, so the stored
+                // velocity is chosen to make that first integrated tick rise by
+                // exactly the vanilla jump speed.
+                let gravity = mc_physics::GRAVITY_BLOCKS_PER_SECOND_SQUARED;
+                let tick = mc_physics::TICK_SECONDS;
+                let target =
+                    mc_physics::LIVING_JUMP_SPEED_BLOCKS_PER_SECOND + input.hop_lift / tick;
+                body.velocity.y = target / config.vertical_air_drag + gravity * tick;
+            } else {
+                // `SlimeMoveControl`: between hops there is no ground traction
+                // (xxa/zza zero, speed zero), so no walking. A knockback lift
+                // is external velocity and stays, exactly like walkers.
+                body.velocity.x = impulse[0];
+                body.velocity.z = impulse[1];
+            }
+        } else {
+            // The stored velocity already carries the decaying combat impulse;
+            // adding it again would catapult a hit slime. Vanilla still steers
+            // in the air, so a wall-hit hop can recover toward the drive.
+            body.velocity.x = carried.x;
+            body.velocity.z = carried.z;
+            let speed = (input.drive[0] * input.drive[0] + input.drive[2] * input.drive[2]).sqrt();
+            if speed > 1.0e-9 {
+                let accel = 0.4;
+                body.velocity.x += (input.drive[0] - carried.x).clamp(-accel, accel);
+                body.velocity.z += (input.drive[2] - carried.z).clamp(-accel, accel);
+            }
+        }
+    }
     // The direction this tick's AI wants to travel: vanilla `MoveControl` turns
     // toward the wanted position, which a combat impulse never moves. It is the
     // drive alone, so no movement-class branch can leak an impulse into it.
diff --git a/crates/mc-core/src/tick/entity_phase/prepare.rs b/crates/mc-core/src/tick/entity_phase/prepare.rs
--- a/crates/mc-core/src/tick/entity_phase/prepare.rs
+++ b/crates/mc-core/src/tick/entity_phase/prepare.rs
@@ -455,7 +455,10 @@
         && blueprint.is_some_and(|blueprint| {
             blueprint.capabilities.hop_lift_per_size > 0.0 || row.loot.slime_size.unwrap_or(1) > 1
         });
-    let think = battle || motion_thinks(view.tick, flags, period);
+    let hop_tick = hops
+        && !row.controls.no_ai
+        && crate::entity_motion::hop_due(body.id.0, view.tick, hop_delay_scale, aggressive);
+    let think = battle || motion_thinks(view.tick, flags, period) || hop_tick;
     let needs_rare = crate::enderman::needs_state(row)
         || crate::plugin_npcs::needs_state(row)
         || crate::creaking::needs_state(body)
diff --git a/crates/mc-core/src/tick/entity_phase/rest.rs b/crates/mc-core/src/tick/entity_phase/rest.rs
--- a/crates/mc-core/src/tick/entity_phase/rest.rs
+++ b/crates/mc-core/src/tick/entity_phase/rest.rs
@@ -101,6 +101,25 @@
         return false;
     }
     let body = &view.bodies[slot.0 as usize];
+    // A hop tick is a decision tick even in rings that would otherwise rest:
+    // refuse before the ring/footprint shortcut, not only before the memo.
+    if let crate::entities::EntityKind::Mob { type_id } = body.kind
+        && let Some(blueprint) = view.registry.blueprint(type_id)
+        && blueprint.capabilities.hops
+        && !view.entities.row(slot).controls.no_ai
+    {
+        let aggressive = (blueprint.capabilities.hop_lift_per_size > 0.0
+            || view.entities.row(slot).loot.slime_size.unwrap_or(1) > 1)
+            && view.hostile.targets.contains_key(&body.id);
+        if crate::entity_motion::hop_due(
+            body.id.0,
+            view.tick,
+            blueprint.capabilities.hop_delay_scale.max(1),
+            aggressive,
+        ) {
+            return false;
+        }
+    }
     if view.hostile.targets.contains_key(&body.id)
         || body
             .hurt_at
